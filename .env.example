# ==============================================================================
# CFO-One Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Airwallex Global Multi-Currency API (Demo / Production) [RECOMMENDED GLOBALLY]
# ------------------------------------------------------------------------------
# Available globally (including Nigeria, UK, US, EU, Asia, Australia).
# To get free Demo credentials in 2 minutes:
# 1. Register for free at https://demo.airwallex.com (or https://www.airwallex.com)
# 2. Go to Account Settings -> Developer -> API Keys
# 3. Copy your Client ID and API Key
AIRWALLEX_CLIENT_ID=""
AIRWALLEX_API_KEY=""
AIRWALLEX_ENV="demo" # "demo" or "production"
AIRWALLEX_API_URL="https://api-demo.airwallex.com/api/v1"

# ------------------------------------------------------------------------------
# 2. Mercury Banking API (Sandbox or Production) [US ONLY]
# ------------------------------------------------------------------------------
# Note: Mercury restricts accounts for users in Nigeria/Africa without US entity.
# If you have an active Mercury account or US entity:
# 1. Sign in to Mercury Dashboard (https://app.mercury.com)
# 2. Go to Settings -> API Access / Tokens
# 3. Create a token with "Read and Send Money with Approval"
MERCURY_API_KEY=""
MERCURY_ACCOUNT_ID=""
MERCURY_API_URL="https://api.mercury.com/api/v1"

# ------------------------------------------------------------------------------
# 3. OutLayer Confidential Enclave (Intel TDX on NEAR Testnet)
# ------------------------------------------------------------------------------
# Enforces hardware per-payment caps inside Intel TDX confidential enclave
OUTLAYER_PAYMENT_KEY=""
OUTLAYER_SECRETS_ACCOUNT=""
OUTLAYER_API_HOST="testnet-api.outlayer.ai"

# ------------------------------------------------------------------------------
# 4. Private LLM Inference (Confidential TEE LLM)
# ------------------------------------------------------------------------------
# For confidential document parsing inside Intel TDX on NEAR AI Cloud
NEAR_AI_API_KEY=""
# Or standard OpenAI API key fallback:
OPENAI_API_KEY=""

# ------------------------------------------------------------------------------
# 5. Local Overrides
# ------------------------------------------------------------------------------
PORT=3000
MONTHLY_BUDGET_USD=3500
MAX_PAYMENT_USD=1000
