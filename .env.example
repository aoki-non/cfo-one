# ==============================================================================
# CFO-One Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Mercury Banking API (Sandbox or Production)
# ------------------------------------------------------------------------------
# To obtain a token:
# 1. Sign in to Mercury Dashboard (https://app.mercury.com or Sandbox)
# 2. Go to Settings -> API Access / Tokens
# 3. Create a token with "Read and Send Money with Approval"
# (Transactions initiated by CFO-One will queue for 1-click owner approval in Mercury)
MERCURY_API_KEY=""
MERCURY_ACCOUNT_ID=""
MERCURY_API_URL="https://api.mercury.com/api/v1"

# ------------------------------------------------------------------------------
# 2. OutLayer Confidential Enclave (Intel TDX on NEAR Testnet)
# ------------------------------------------------------------------------------
# Enforces hardware per-payment caps and runs confidential connectors
OUTLAYER_PAYMENT_KEY=""
OUTLAYER_SECRETS_ACCOUNT=""
OUTLAYER_API_HOST="testnet-api.outlayer.ai"

# ------------------------------------------------------------------------------
# 3. Private LLM Inference (Confidential TEE LLM)
# ------------------------------------------------------------------------------
# For confidential document parsing inside Intel TDX on NEAR AI Cloud
NEAR_AI_API_KEY=""
# Or standard OpenAI API key fallback:
OPENAI_API_KEY=""

# ------------------------------------------------------------------------------
# 4. Optional Local Overrides
# ------------------------------------------------------------------------------
PORT=3000
MONTHLY_BUDGET_USD=3500
MAX_PAYMENT_USD=1000
